# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# network archives / debug captures
*.har
# Plain "env" secrets file (no dot) must never be committed
/env

# SEO audit reports (claude-seo plugin output)
/byiora.com.np-audit/

# AI agent / editor tooling (local only)
/.claude/
/.agents/
/skills/
skills-lock.json
/.cursor/
/.vscode/
/.idea/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# local logs and test output
*.log
/coverage/

# promo video (Remotion) build output, deps and screen recordings
/promo-video/node_modules/
/promo-video/out/
/promo-video/public/*.webm
/promo-video/.recording-tmp/
/promo-video/.agents/
/promo-video/.claude/
/promo-video/skills-lock.json
/promo-video/public/music.wav
/promo-video/public/thumb-screen*.png
